# 从 Neon 控制台 Connect 窗口复制 Pooled connection（不要提交真实值）
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Render 中自行生成一段至少 32 位的随机字符串，用于保护管理、删除和导出接口
ADMIN_TOKEN=replace-with-a-long-random-secret

FRONTEND_URL=https://zt20261003.love

# 仅本地文件模式可选；Render 临时磁盘不能代替 Neon
# BACKUP_DIR=C:\path\to\durable\backup
